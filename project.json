{
  "name": "cictl",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["scope:tools", "type:go"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "bash ./ctl.sh build", "cwd": "{projectRoot}" },
      "cache": false
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "bash ./ctl.sh test", "cwd": "{projectRoot}" },
      "cache": false
    },
    "test-review": {
      "executor": "nx:run-commands",
      "options": { "command": "bash ./ctl.sh test-review", "cwd": "{projectRoot}" },
      "cache": false
    },
    "test-workflow": {
      "executor": "nx:run-commands",
      "options": { "command": "bash ./ctl.sh test-workflow", "cwd": "{projectRoot}" },
      "cache": false
    },
    "fmt": {
      "executor": "nx:run-commands",
      "options": { "command": "bash ./ctl.sh fmt", "cwd": "{projectRoot}" },
      "cache": false
    },
    "vet": {
      "executor": "nx:run-commands",
      "options": { "command": "bash ./ctl.sh vet", "cwd": "{projectRoot}" },
      "cache": false
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "bash ./ctl.sh lint", "cwd": "{projectRoot}" },
      "cache": false
    },
    "gate": {
      "executor": "nx:run-commands",
      "options": { "command": "bash ./ctl.sh gate", "cwd": "{projectRoot}" },
      "cache": false
    },
    "install": {
      "executor": "nx:run-commands",
      "options": { "command": "bash ./ctl.sh install", "cwd": "{projectRoot}" },
      "cache": false
    }
  }
}
